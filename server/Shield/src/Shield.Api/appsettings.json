{
  "Firebase": {
    "ProjectId": "your-firebase-project-id",
    "ServiceAccountKeyPath": "firebase.json",
    "UserEmailDomain": "domain.com",
    "Firestore": {
      "Collection": "users",
      "Fields": {
        "UserId": "userId",
        "SocialId": "socialId",
        "Username": "username",
        "RolesField": "roles"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
